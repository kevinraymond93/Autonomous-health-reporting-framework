module master_fsm (

    input wire clk,
    input wire reset,

    input wire start_poll,

    input wire i2c_done,
    input wire ack_received,

    output reg master_start,

    output reg [2:0] subsystem_id,

    output reg report_done,

    output reg busy,

    output reg [3:0] state

);

localparam IDLE      = 4'd0;
localparam START_I2C = 4'd1;
localparam WAIT_I2C  = 4'd2;
localparam NEXT      = 4'd3;
localparam COMPLETE  = 4'd4;


always @(posedge clk or posedge reset) begin

    if (reset) begin

        state        <= IDLE;
        subsystem_id <= 3'd0;

    end

    else begin

        case (state)

            IDLE: begin

                if (start_poll) begin

                    subsystem_id <= 3'd0;

                    state <= START_I2C;

                end

            end


            START_I2C: begin

                state <= WAIT_I2C;

            end


            WAIT_I2C: begin

                if (i2c_done)

                    state <= NEXT;

            end


            NEXT: begin

                // Last subsystem = Error
                if (subsystem_id == 3'd3)

                    state <= COMPLETE;

                else begin

                    subsystem_id <= subsystem_id + 1'b1;

                    state <= START_I2C;

                end

            end


            COMPLETE: begin

                state <= IDLE;

            end


            default: begin

                state <= IDLE;

            end

        endcase

    end

end


always @(*) begin

    master_start = 1'b0;

    report_done = 1'b0;

    busy = 1'b0;


    case (state)

        IDLE: begin

            busy = 1'b0;

        end


        START_I2C: begin

            master_start = 1'b1;

            busy = 1'b1;

        end


        WAIT_I2C: begin

            busy = 1'b1;

        end


        NEXT: begin

            busy = 1'b1;

        end


        COMPLETE: begin

            report_done = 1'b1;

            busy = 1'b0;

        end

    endcase

end

endmodule
