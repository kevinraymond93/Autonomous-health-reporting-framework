module top_health_framework #(
    parameter I2C_DIVIDER = 5
)(
    input wire clk,
    input wire reset,
    input wire start_poll,

    inout wire sda,

    output wire scl,

    output wire [2:0] subsystem_id,

    output wire [6:0] selected_address,

    output wire [7:0] health_data,

    output wire [1:0] health_status,

    output wire report_done,

    output wire busy
);


// ====================================================
// INTERNAL SIGNALS
// ====================================================

wire master_start;

wire i2c_done;

wire ack_received;

wire [7:0] selected_data;


// ====================================================
// FOUR SUBSYSTEM VALUES
// ====================================================

wire [7:0] voltage_data;

wire [7:0] current_data;

wire [7:0] temperature_data;

wire [7:0] error_data;


// ====================================================
// HEALTH VALUES
// ====================================================

assign voltage_data     = 8'd92;

assign current_data     = 8'd84;

assign temperature_data = 8'd76;

assign error_data       = 8'd40;


// ====================================================
// ADDRESS GENERATION
// ====================================================

assign selected_address =

    (subsystem_id == 3'd0) ? 7'h10 :

    (subsystem_id == 3'd1) ? 7'h20 :

    (subsystem_id == 3'd2) ? 7'h30 :

                             7'h40;


// ====================================================
// ADDRESS DECODER
// ====================================================

address_decoder DECODER (

    .address(selected_address),

    .voltage_data(voltage_data),

    .current_data(current_data),

    .temperature_data(temperature_data),

    .error_data(error_data),

    .selected_data(selected_data)

);


// ====================================================
// HEALTH EVALUATOR
// ====================================================

health_evaluator EVALUATOR (

    .health_value(selected_data),

    .health_status(health_status)

);


assign health_data = selected_data;


// ====================================================
// MASTER FSM
// ====================================================

master_fsm FSM (

    .clk(clk),

    .reset(reset),

    .start_poll(start_poll),

    .i2c_done(i2c_done),

    .ack_received(ack_received),

    .master_start(master_start),

    .subsystem_id(subsystem_id),

    .report_done(report_done),

    .busy(busy),

    .state()

);


// ====================================================
// SCL GENERATOR
// ====================================================

scl_gen #(

    .DIVIDER(I2C_DIVIDER)

) SCL_GENERATOR (

    .clk(clk),

    .reset(reset),

    .enable(busy),

    .scl(scl),

    .scl_tick()

);


// ====================================================
// ACK LOGIC
// ====================================================

ack_logic ACK (

    .clk(clk),

    .reset(reset),

    .sda_in(sda),

    .ack_enable(busy),

    .ack_received(ack_received)

);


// ====================================================
// TRANSACTION COMPLETION
// ====================================================

assign i2c_done = ack_received;


endmodule
