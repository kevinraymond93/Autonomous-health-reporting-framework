`timescale 1ns / 1ps

module tb_top_health_framework;


// ====================================================
// CLOCK
// ====================================================

reg clk;


// ====================================================
// RESET
// ====================================================

reg reset;


// ====================================================
// START
// ====================================================

reg start_poll;


// ====================================================
// I2C BUS
// ====================================================

wire scl;

wire sda;


// ====================================================
// OUTPUTS
// ====================================================

wire [2:0] subsystem_id;

wire [6:0] selected_address;

wire [7:0] health_data;

wire [1:0] health_status;

wire report_done;

wire busy;


// ====================================================
// DUT
// ====================================================

top_health_framework #(

    .I2C_DIVIDER(5)

) DUT (

    .clk(clk),

    .reset(reset),

    .start_poll(start_poll),

    .sda(sda),

    .scl(scl),

    .subsystem_id(subsystem_id),

    .selected_address(selected_address),

    .health_data(health_data),

    .health_status(health_status),

    .report_done(report_done),

    .busy(busy)

);


// ====================================================
// CLOCK
// ====================================================

always #5 clk = ~clk;


// ====================================================
// VOLTAGE
// 10H → 92
// ====================================================

i2c_slave_model #(

    .SLAVE_ADDRESS(7'h10),

    .HEALTH_VALUE(8'd92)

) VOLTAGE_SLAVE (

    .reset(reset),

    .scl(scl),

    .sda(sda)

);


// ====================================================
// CURRENT
// 20H → 84
// ====================================================

i2c_slave_model #(

    .SLAVE_ADDRESS(7'h20),

    .HEALTH_VALUE(8'd84)

) CURRENT_SLAVE (

    .reset(reset),

    .scl(scl),

    .sda(sda)

);


// ====================================================
// TEMPERATURE
// 30H → 76
// ====================================================

i2c_slave_model #(

    .SLAVE_ADDRESS(7'h30),

    .HEALTH_VALUE(8'd76)

) TEMPERATURE_SLAVE (

    .reset(reset),

    .scl(scl),

    .sda(sda)

);


// ====================================================
// ERROR
// 40H → 40
// ====================================================

i2c_slave_model #(

    .SLAVE_ADDRESS(7'h40),

    .HEALTH_VALUE(8'd40)

) ERROR_SLAVE (

    .reset(reset),

    .scl(scl),

    .sda(sda)

);


// ====================================================
// TEST SEQUENCE
// ====================================================

initial begin

    clk = 1'b0;

    reset = 1'b1;

    start_poll = 1'b0;


    // Reset period

    #100;

    reset = 1'b0;


    // Start polling

    #100;

    start_poll = 1'b1;

    #10;

    start_poll = 1'b0;


    // Allow simulation to run

    #10000;


    $display("-------------------------------------");

    $display("4-SUBSYSTEM HEALTH REPORT COMPLETE");

    $display("-------------------------------------");


    $finish;

end


// ====================================================
// MONITOR
// ====================================================

always @(posedge clk) begin

    $display(

        "TIME=%0t | ID=%0d | ADDRESS=%h | HEALTH=%0d | STATUS=%0d | BUSY=%b | ACK=%b | DONE=%b",

        $time,

        subsystem_id,

        selected_address,

        health_data,

        health_status,

        busy,

        DUT.ack_received,

        report_done

    );

end

endmodule

