module scl_gen #(
    parameter DIVIDER = 5
)(
    input  wire clk,
    input  wire reset,
    input  wire enable,

    output reg scl,
    output reg scl_tick
);

reg [15:0] count;

always @(posedge clk or posedge reset) begin

    if (reset) begin
        count    <= 16'd0;
        scl      <= 1'b1;
        scl_tick <= 1'b0;
    end

    else if (!enable) begin
        count    <= 16'd0;
        scl      <= 1'b1;
        scl_tick <= 1'b0;
    end

    else begin

        scl_tick <= 1'b0;

        if (count == DIVIDER-1) begin
            count    <= 16'd0;
            scl      <= ~scl;
            scl_tick <= 1'b1;
        end

        else begin
            count <= count + 1'b1;
        end

    end

end

endmodule
