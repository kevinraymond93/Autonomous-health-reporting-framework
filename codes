module shift_reg (

    input wire clk,
    input wire reset,

    input wire load_enable,
    input wire shift_enable,

    input wire [7:0] parallel_data,

    output reg serial_data,
    output reg shift_done

);

reg [7:0] shift_register;
reg [3:0] bit_count;

always @(posedge clk or posedge reset) begin

    if (reset) begin

        shift_register <= 8'd0;
        serial_data    <= 1'b0;
        bit_count      <= 4'd0;
        shift_done     <= 1'b0;

    end

    else begin

        shift_done <= 1'b0;

        if (load_enable) begin

            shift_register <= parallel_data;
            serial_data    <= parallel_data[7];
            bit_count      <= 4'd0;

        end

        else if (shift_enable) begin

            shift_register <= {
                shift_register[6:0],
                1'b0
            };

            serial_data <= shift_register[6];

            bit_count <= bit_count + 1'b1;

            if (bit_count == 4'd7)
                shift_done <= 1'b1;

        end

    end

end

endmodule
-----------------------------------------------

module ack_logic (

    input wire clk,
    input wire reset,

    input wire sda_in,
    input wire ack_enable,

    output reg ack_received

);

always @(posedge clk or posedge reset) begin

    if (reset) begin

        ack_received <= 1'b0;

    end

    else if (ack_enable) begin

        if (sda_in == 1'b0)
            ack_received <= 1'b1;

        else
            ack_received <= 1'b0;

    end

    else begin

        ack_received <= 1'b0;

    end

end

endmodule
