module i2c_slave_model #(

    parameter SLAVE_ADDRESS = 7'h10,

    parameter HEALTH_VALUE = 8'd92

)(
    input wire reset,

    input wire scl,

    inout wire sda
);

reg sda_drive_low;

reg [7:0] address_shift;

reg [3:0] bit_count;

reg address_matched;

assign sda = sda_drive_low ? 1'b0 : 1'bz;


always @(posedge scl or posedge reset) begin

    if (reset) begin

        address_shift   <= 8'd0;

        bit_count       <= 4'd0;

        address_matched <= 1'b0;

    end

    else begin

        if (bit_count < 4'd8) begin

            address_shift <= {

                address_shift[6:0],

                sda

            };

            bit_count <= bit_count + 1'b1;

        end

        else begin

            if (address_shift[7:1] == SLAVE_ADDRESS)

                address_matched <= 1'b1;

            else

                address_matched <= 1'b0;

            bit_count <= 4'd0;

        end

    end

end


always @(negedge scl or posedge reset) begin

    if (reset)

        sda_drive_low <= 1'b0;

    else if (address_matched)

        sda_drive_low <= 1'b1;

    else

        sda_drive_low <= 1'b0;

end

endmodule
