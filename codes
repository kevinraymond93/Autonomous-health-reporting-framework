module address_decoder (

    input wire [6:0] address,

    input wire [7:0] voltage_data,
    input wire [7:0] current_data,
    input wire [7:0] temperature_data,
    input wire [7:0] error_data,

    output reg [7:0] selected_data

);

always @(*) begin

    case (address)

        // Voltage subsystem
        7'h10:
            selected_data = voltage_data;

        // Current subsystem
        7'h20:
            selected_data = current_data;

        // Temperature subsystem
        7'h30:
            selected_data = temperature_data;

        // Error subsystem
        7'h40:
            selected_data = error_data;

        // Invalid address
        default:
            selected_data = 8'd0;

    endcase

end

endmodule
-----------------------------------------------

module memory_reg (

    input wire clk,
    input wire reset,

    input wire write_enable,

    input wire [7:0] data_in,

    output reg [7:0] data_out

);

reg [7:0] health_register;

always @(posedge clk or posedge reset) begin

    if (reset) begin

        health_register <= 8'd0;
        data_out        <= 8'd0;

    end

    else if (write_enable) begin

        health_register <= data_in;
        data_out        <= data_in;

    end

end

endmodule
-----------------------------------------------

module health_evaluator (

    input wire [7:0] health_value,

    output reg [1:0] health_status

);

localparam NORMAL   = 2'b00;
localparam WARNING  = 2'b01;
localparam CRITICAL = 2'b10;

always @(*) begin

    if (health_value >= 8'd80)

        health_status = NORMAL;

    else if (health_value >= 8'd50)

        health_status = WARNING;

    else

        health_status = CRITICAL;

end

endmodule
