module counters (

    input wire clk,
    input wire reset,

    input wire bit_count_enable,
    input wire bit_count_clear,

    input wire time_count_enable,
    input wire time_count_clear,

    output reg [3:0] bit_count,
    output reg [15:0] time_count,

    output wire bit_count_done

);

assign bit_count_done = (bit_count == 4'd8);

always @(posedge clk or posedge reset) begin

    if (reset) begin

        bit_count  <= 4'd0;
        time_count <= 16'd0;

    end

    else begin

        if (bit_count_clear)
            bit_count <= 4'd0;

        else if (bit_count_enable)
            bit_count <= bit_count + 1'b1;


        if (time_count_clear)
            time_count <= 16'd0;

        else if (time_count_enable)
            time_count <= time_count + 1'b1;

    end

end

endmodule
